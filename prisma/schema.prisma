generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { USER ADMIN }
enum CampaignStatus { PENDING_REVIEW ACTIVE PAUSED COMPLETED REJECTED }
enum AdViewStatus { STARTED COMPLETED EXPIRED }
enum WalletTransactionType { DEPOSIT CAMPAIGN_FUNDING AD_REWARD WITHDRAWAL REFUND ADMIN_ADJUSTMENT }
enum RequestStatus { PENDING APPROVED REJECTED }

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet?
  campaigns Campaign[]
  adViews AdView[]
  transactions WalletTransaction[]
  deposits Deposit[]
  withdrawals Withdrawal[]
  auditLogs AuditLog[]
}

model Wallet {
  id String @id @default(uuid())
  userId String @unique
  balance Decimal @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id String @id @default(uuid())
  walletId String
  userId String
  amount Decimal @db.Decimal(12, 2)
  type WalletTransactionType
  description String
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Campaign {
  id String @id @default(uuid())
  ownerId String
  title String
  description String
  targetUrl String
  budgetRemaining Decimal @db.Decimal(12, 2)
  clickReward Decimal @db.Decimal(8, 2)
  status CampaignStatus @default(PENDING_REVIEW)
  reviewedAt DateTime?
  reviewNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  views AdView[]
  @@index([status, createdAt])
  @@index([ownerId, createdAt])
}

model AdView {
  id String @id @default(uuid())
  token String @unique
  userId String
  campaignId String
  status AdViewStatus @default(STARTED)
  startedAt DateTime @default(now())
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
  @@index([campaignId, status])
}

model Deposit {
  id String @id @default(uuid())
  userId String
  amount Decimal @db.Decimal(12, 2)
  method String
  reference String
  status RequestStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Withdrawal {
  id String @id @default(uuid())
  userId String
  amount Decimal @db.Decimal(12, 2)
  method String
  destination String
  status RequestStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  entity String
  entityId String
  metadata String?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}
